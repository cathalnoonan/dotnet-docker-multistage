<Project>
  <PropertyGroup>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!-- Allow the Dockerfile build to produce project specific folders from a solution-level "dotnet publish" -->
  <PropertyGroup Condition=" '$(DOTNET_RUNNING_IN_CONTAINER)' == 'true' ">
    <PublishDir>/dist/$(MSBuildProjectName)</PublishDir>
  </PropertyGroup>
</Project>
